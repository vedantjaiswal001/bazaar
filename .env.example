# BAZAAR environment. Copy to `.env` and fill in. NEVER commit `.env`.
#
# Razorpay Test Mode credentials (Phase 2). Get these from the Razorpay
# Dashboard -> Settings -> API Keys, while the dashboard is in TEST MODE.
# These are TEST keys only. This project never touches live money.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signing secret (Phase 2). Razorpay Dashboard -> Settings -> Webhooks.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# Path to the SQLite database file (optional; defaults to ./bazaar.db).
# BAZAAR_DB_PATH=./bazaar.db

# Default mandate time-to-live in seconds (optional; default 900 = 15 minutes).
# BAZAAR_MANDATE_TTL_SECONDS=900
